{
  "name": "lunch-restaurant-discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot that helps teams decide where to eat lunch based on preferences and office attendance",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:local": "node test-local.js",
    "test:comprehensive": "node test-comprehensive.js",
    "test:mock": "node test-discord-mock.js",
    "test:removal": "node test-removal.js",
    "test:all": "npm run test:local && npm run test:comprehensive && npm run test:mock && npm run test:removal"
  },
  "keywords": ["discord", "bot", "restaurant", "lunch", "team"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
